// Workbench's built-in sign-in clients, baked into the app so nobody has to make their own.
// Copy to Secrets.xcconfig (git-ignored; build.sh does it when it's missing) and fill in.
// Settings → Accounts can still take someone's own client or token instead.

// Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type Desktop app.
// Desktop clients ship their secret inside the app; Google expects that.
WORKBENCH_GOOGLE_CLIENT_ID =
WORKBENCH_GOOGLE_CLIENT_SECRET =

// GitHub OAuth app with Device Flow enabled (no secret needed).
WORKBENCH_GITHUB_CLIENT_ID =

// Linear OAuth app, callback http://localhost:53682/callback (PKCE, so no secret needed).
WORKBENCH_LINEAR_CLIENT_ID =
