// How Warsha is signed. Without a certificate it's signed to run on this Mac only, like the
// SwiftPM build, so the Keychain asks again after each rebuild. With your Apple Development
// certificate (Xcode → Settings → Accounts), Local.xcconfig signs with it instead and the prompts
// stop. build.sh writes Local.xcconfig from the certificate; it's git-ignored, since the team is yours.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"

// Warsha's own sign-in clients (Google, GitHub, Linear), baked into the app so people sign in
// without making their own. They're in Secrets.xcconfig, kept out of git; see Secrets.example.xcconfig.
WARSHA_GOOGLE_CLIENT_ID =
WARSHA_GOOGLE_CLIENT_SECRET =
WARSHA_GITHUB_CLIENT_ID =
WARSHA_LINEAR_CLIENT_ID =
#include? "Secrets.xcconfig"
