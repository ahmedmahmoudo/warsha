{
  "name": "workbench",
  "version": "1.0.0",
  "description": "Personal dashboard: PRs + Linear, and a weekly activity view",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
