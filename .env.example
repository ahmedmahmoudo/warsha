# Copy to .env.local and fill in. Never commit .env.local.

# GitHub token with `repo` + `read:org`. Quickest: paste the output of `gh auth token`.
GITHUB_TOKEN=

# Comma-separated repos to search; leave empty for every repo you can see.
GITHUB_REPOS=everlab-au/ev-admin

# Comma-separated GitHub logins whose PRs the "Team" view shows.
GITHUB_TEAM=

# Linear personal API key: Linear → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=
