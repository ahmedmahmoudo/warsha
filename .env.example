# Copy to .env.local and fill in. Never commit .env.local.

# GitHub token with `repo` + `read:org`. Quickest: paste the output of `gh auth token`.
GITHUB_TOKEN=

# Comma-separated repos to search; leave empty for every repo you can see.
GITHUB_REPOS=everlab-au/ev-admin

# Comma-separated GitHub logins whose PRs the "Team" view shows.
GITHUB_TEAM=

# Linear personal API key: Linear → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=

# Optional. Where repos are cloned locally, for the "resolve conflicts with Claude" action:
# comma-separated owner/repo=/absolute/path. A repo cloned next to this project is found without it.
LOCAL_REPOS=

# Optional. The time zone the Activity page's days and weeks follow (Monday to Sunday).
TIMEZONE=Australia/Sydney

# Optional. Where Workbench keeps its own data (pins, notes, todos). Gitignored.
DB_PATH=data/workbench.sqlite
